<Project Sdk="Microsoft.NET.Sdk">
  <!-- The platform-neutral core: no Windows APIs, so it builds and tests on
       Linux and macOS too (docs/inline-review-design.md section 6). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Researchly.Overlay.Core</RootNamespace>
    <AssemblyName>Researchly.Overlay.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The eligibility rules live once in the repository and are shared with
         the Mac client. They are copied next to every assembly that uses the
         core (the app and the tests), under rules\. -->
    <Content Include="$(ResearchlyRulesDir)fields.json" Link="rules\fields.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(ResearchlyRulesDir)apps-windows.json" Link="rules\apps-windows.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Researchly.Overlay.Core.Tests" />
  </ItemGroup>
</Project>
