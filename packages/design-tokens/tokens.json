{
  "$description": "Researchly's design tokens (S4d R2): the single source for the website, the Word pane and the desktop clients. Three tiers: primitive hue ramps (Researchly's own colours, taken from the website palette of 2026-10), semantic roles, and component tokens. Every semantic and component colour has a light and a dark value; values are #rrggbb or #rrggbbaa, or a {reference} to a primitive ({hue.step}) or to a semantic token in the same mode ({role.variant}). Run `node scripts/build.mjs` to regenerate dist/; `--check` fails on a stale dist, a missing dark value or contrast below the floor (DESIGN.md, docs/inline-review-design.md §4).",
  "version": 1,
  "primitive": {
    "paper": {
      "0": "#ffffff",
      "50": "#f4f5f3",
      "100": "#eceeeb",
      "200": "#d5d9d4"
    },
    "slate": {
      "300": "#aeb3bd",
      "400": "#858b93",
      "450": "#7d838f",
      "600": "#4a515b",
      "900": "#1b1f24"
    },
    "night": {
      "50": "#e9e7e2",
      "600": "#353a44",
      "700": "#23272e",
      "800": "#1b1e23",
      "900": "#14161a",
      "950": "#10141c"
    },
    "navy": {
      "200": "#d0dcf0",
      "300": "#b8c8e6",
      "800": "#26344d",
      "900": "#1a2539"
    },
    "azure": {
      "50": "#edf1f7",
      "200": "#b9c6db",
      "300": "#8ab4ff",
      "600": "#1f5fbf",
      "700": "#1d4f9c",
      "850": "#3a4a66",
      "900": "#1d2533"
    },
    "vermillion": {
      "100": "#fbe4d6",
      "300": "#ffa070",
      "400": "#f08a4b",
      "500": "#d55e00",
      "700": "#9e3b00",
      "a26": "#d55e0042"
    },
    "blue": {
      "100": "#dcebf6",
      "300": "#86c8f2",
      "400": "#56b4e9",
      "500": "#0072b2",
      "600": "#005a8f",
      "a32": "#0072b252"
    },
    "green": {
      "100": "#d6efe5",
      "300": "#66d4b0",
      "400": "#3cc196",
      "500": "#009e73",
      "700": "#00694d",
      "a26": "#009e7342"
    },
    "orchid": {
      "100": "#f6e2ed",
      "300": "#eaa8cd",
      "400": "#d88bb8",
      "500": "#c06c9b",
      "700": "#8a3a69",
      "a26": "#cc79a742"
    },
    "amber": {
      "100": "#fbefd9",
      "300": "#f0b847",
      "400": "#e69f00",
      "600": "#a86a00",
      "700": "#8a5a00",
      "a22": "#e69f0038"
    }
  },
  "semantic": {
    "surface": {
      "page": { "light": "{paper.50}", "dark": "{night.900}" },
      "raised": { "light": "{paper.0}", "dark": "{night.800}" },
      "sunken": { "light": "{paper.100}", "dark": "{night.700}" }
    },
    "text": {
      "primary": { "light": "{slate.900}", "dark": "{night.50}" },
      "secondary": { "light": "{slate.600}", "dark": "{slate.300}" },
      "on-accent": { "light": "{paper.0}", "dark": "{night.950}" }
    },
    "line": {
      "hairline": { "light": "{paper.200}", "dark": "{night.600}" },
      "strong": { "light": "{slate.400}", "dark": "{slate.450}" }
    },
    "accent": {
      "strong": { "light": "{navy.800}", "dark": "{navy.300}" },
      "hover": { "light": "{navy.900}", "dark": "{navy.200}" }
    },
    "correction": {
      "strong": { "light": "{vermillion.500}", "dark": "{vermillion.400}" },
      "subtle": { "light": "{vermillion.100}", "dark": "{vermillion.a26}" },
      "text": { "light": "{vermillion.700}", "dark": "{vermillion.300}" }
    },
    "improvement": {
      "strong": { "light": "{blue.500}", "dark": "{blue.400}" },
      "subtle": { "light": "{blue.100}", "dark": "{blue.a32}" },
      "text": { "light": "{blue.600}", "dark": "{blue.300}" }
    },
    "convention": {
      "strong": { "light": "{green.500}", "dark": "{green.400}" },
      "subtle": { "light": "{green.100}", "dark": "{green.a26}" },
      "text": { "light": "{green.700}", "dark": "{green.300}" }
    },
    "preference": {
      "strong": { "light": "{orchid.500}", "dark": "{orchid.400}" },
      "subtle": { "light": "{orchid.100}", "dark": "{orchid.a26}" },
      "text": { "light": "{orchid.700}", "dark": "{orchid.300}" }
    },
    "focus": {
      "strong": { "light": "{azure.600}", "dark": "{azure.300}" },
      "subtle": { "light": "{azure.50}", "dark": "{azure.900}" },
      "text": { "light": "{azure.700}", "dark": "{azure.300}" }
    },
    "warning": {
      "strong": { "light": "{amber.600}", "dark": "{amber.400}" },
      "subtle": { "light": "{amber.100}", "dark": "{amber.a22}" },
      "text": { "light": "{amber.700}", "dark": "{amber.300}" }
    },
    "offline": {
      "strong": { "light": "{slate.400}", "dark": "{slate.450}" },
      "subtle": { "light": "{paper.100}", "dark": "{night.700}" },
      "text": { "light": "{slate.600}", "dark": "{slate.300}" }
    }
  },
  "component": {
    "underline": {
      "correction": { "color": { "light": "{correction.strong}", "dark": "{correction.strong}" }, "pattern": "solid", "thickness": 2 },
      "improvement": { "color": { "light": "{improvement.strong}", "dark": "{improvement.strong}" }, "pattern": "dashed", "thickness": 2 },
      "convention": { "color": { "light": "{convention.strong}", "dark": "{convention.strong}" }, "pattern": "dotted", "thickness": 3 },
      "preference": { "color": { "light": "{preference.strong}", "dark": "{preference.strong}" }, "pattern": "wavy-dotted", "thickness": 2 }
    },
    "highlight": {
      "correction": { "light": "{correction.subtle}", "dark": "{correction.subtle}" },
      "improvement": { "light": "{improvement.subtle}", "dark": "{improvement.subtle}" },
      "convention": { "light": "{convention.subtle}", "dark": "{convention.subtle}" },
      "preference": { "light": "{preference.subtle}", "dark": "{preference.subtle}" }
    },
    "card": {
      "rail": {
        "correction": { "light": "{correction.strong}", "dark": "{correction.strong}" },
        "improvement": { "light": "{improvement.strong}", "dark": "{improvement.strong}" },
        "convention": { "light": "{convention.strong}", "dark": "{convention.strong}" },
        "preference": { "light": "{preference.strong}", "dark": "{preference.strong}" }
      }
    },
    "badge": {
      "correction": {
        "text": { "light": "{correction.text}", "dark": "{correction.text}" },
        "background": { "light": "{correction.subtle}", "dark": "{correction.subtle}" }
      },
      "improvement": {
        "text": { "light": "{improvement.text}", "dark": "{improvement.text}" },
        "background": { "light": "{improvement.subtle}", "dark": "{improvement.subtle}" }
      },
      "convention": {
        "text": { "light": "{convention.text}", "dark": "{convention.text}" },
        "background": { "light": "{convention.subtle}", "dark": "{convention.subtle}" }
      },
      "preference": {
        "text": { "light": "{preference.text}", "dark": "{preference.text}" },
        "background": { "light": "{preference.subtle}", "dark": "{preference.subtle}" }
      }
    },
    "widget": {
      "surface": { "light": "{surface.raised}", "dark": "{surface.raised}" },
      "border": { "light": "{line.strong}", "dark": "{line.strong}" },
      "mark": { "light": "{text.secondary}", "dark": "{text.secondary}" },
      "ring": { "light": "{focus.strong}", "dark": "{focus.strong}" },
      "warning": { "light": "{warning.strong}", "dark": "{warning.strong}" },
      "offline": { "light": "{offline.strong}", "dark": "{offline.strong}" },
      "badge": {
        "background": { "light": "{accent.strong}", "dark": "{accent.strong}" },
        "text": { "light": "{text.on-accent}", "dark": "{text.on-accent}" }
      }
    }
  },
  "categories": {
    "correction": {
      "label": "Correction",
      "critical": true,
      "icon": "circle-cross",
      "sfSymbol": "xmark.circle",
      "segoeGlyph": "EA39",
      "wordAnnotationColor": "Red",
      "underline": "solid"
    },
    "improvement": {
      "label": "Improvement",
      "critical": false,
      "icon": "arrow-up",
      "sfSymbol": "arrow.up",
      "segoeGlyph": "E74A",
      "wordAnnotationColor": "Blue",
      "underline": "dashed"
    },
    "convention": {
      "label": "Convention",
      "critical": false,
      "icon": "open-book",
      "sfSymbol": "book",
      "segoeGlyph": "E8F1",
      "wordAnnotationColor": "Green",
      "underline": "dotted"
    },
    "preference": {
      "label": "Preference",
      "critical": false,
      "icon": "sliders",
      "sfSymbol": "slider.horizontal.3",
      "segoeGlyph": "E9E9",
      "wordAnnotationColor": "Lavender",
      "underline": "wavy-dotted"
    }
  },
  "states": {
    "$description": "The six states every surface shows (docs/inline-review-design.md §3): the website's status line, the Word pane's header, the desktop widget and its menu-bar item. `look` is the shape, `color` the component token it is drawn in, `label` the words beside or under it (plain words, curly apostrophes), `{n}` a count. After a failure, retries wait `retrySeconds` in turn, then the last value for good.",
    "order": ["hidden", "checking", "issues", "clear", "partial", "offline"],
    "retrySeconds": [2, 4, 8, 16, 30],
    "hidden": { "look": "none", "color": "widget.mark", "label": "Paused", "description": "Not checking here: paused, or not a place Researchly reads." },
    "checking": { "look": "ring", "color": "widget.ring", "label": "Checking…", "description": "Checking what you just wrote." },
    "issues": { "look": "badge", "color": "widget.badge.background", "label": "{n} suggestions", "labelOne": "1 suggestion", "description": "Suggestions to look at." },
    "clear": { "look": "tick", "color": "widget.mark", "label": "Nothing to suggest", "description": "Checked: nothing to suggest." },
    "partial": { "look": "warning", "color": "widget.warning", "label": "Checked in part", "description": "Checked, but part of the checking was off. The reason is in the details." },
    "offline": { "look": "crossed", "color": "widget.offline", "label": "Can’t check right now", "description": "Researchly can’t be reached. It will try again by itself." }
  },
  "patterns": {
    "solid": { "css": "solid" },
    "dashed": { "css": "dashed" },
    "dotted": { "css": "dotted" },
    "wavy-dotted": { "css": "wavy" }
  }
}
