{
  "components": {
    "schemas": {
      "AnalyzeOptions": {
        "additionalProperties": false,
        "properties": {
          "disabled_rules": {
            "description": "Rule ids to mute for this request, e.g. [\"G101\"]. For a signed-in caller these are added to the rules muted in their account settings.",
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "title": "Disabled Rules",
            "type": "array"
          },
          "show_preferences": {
            "default": false,
            "description": "Include Preference-type suggestions (hidden by default).",
            "title": "Show Preferences",
            "type": "boolean"
          }
        },
        "title": "AnalyzeOptions",
        "type": "object"
      },
      "AnalyzeRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "The document text. Held in memory for this request only; never stored or logged.",
            "maxLength": 1000000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "format": {
            "$ref": "#/components/schemas/Format",
            "default": "plain",
            "description": "How to read `content`."
          },
          "options": {
            "$ref": "#/components/schemas/AnalyzeOptions"
          }
        },
        "required": [
          "content"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "additionalProperties": false,
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Shown suggestions per category.",
            "title": "Counts",
            "type": "object"
          },
          "elapsed_ms": {
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "engine": {
            "$ref": "#/components/schemas/EngineInfo"
          },
          "health": {
            "description": "Every surface must show a degraded tier (CLAUDE.md: no silent tiers).",
            "items": {
              "$ref": "#/components/schemas/TierHealth"
            },
            "title": "Health",
            "type": "array"
          },
          "hidden_preferences": {
            "minimum": 0.0,
            "title": "Hidden Preferences",
            "type": "integer"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Metrics"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "sections_detected": {
            "items": {
              "type": "string"
            },
            "title": "Sections Detected",
            "type": "array"
          },
          "signed_in": {
            "default": false,
            "description": "True when a valid account token came with the request and its settings were looked up.",
            "title": "Signed In",
            "type": "boolean"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions",
          "counts",
          "hidden_preferences",
          "sections_detected",
          "health",
          "engine",
          "elapsed_ms"
        ],
        "title": "AnalyzeResponse",
        "type": "object"
      },
      "Category": {
        "description": "The four-type taxonomy (CLAUDE.md #3). Conventions are never errors;\npreferences are hidden unless asked for.",
        "enum": [
          "correction",
          "improvement",
          "convention",
          "preference"
        ],
        "title": "Category",
        "type": "string"
      },
      "EngineInfo": {
        "additionalProperties": false,
        "properties": {
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "rules_loaded": {
            "title": "Rules Loaded",
            "type": "integer"
          },
          "service_version": {
            "title": "Service Version",
            "type": "string"
          }
        },
        "required": [
          "service_version",
          "core_version",
          "rules_loaded"
        ],
        "title": "EngineInfo",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "Every non-2xx response. `code` is stable and machine-readable;\n`message` is for people and never contains document text.",
        "properties": {
          "code": {
            "description": "One of: invalid_request, malformed_json, malformed_request, payload_too_large, unsupported_media_type, unsupported_file, unreadable_file, unauthorized, sign_in_required, auth_unavailable, rate_limited, not_found, method_not_allowed, internal, or http_error for any other HTTP status",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "description": "Quote this when reporting a problem.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FixSafety": {
        "enum": [
          "safe",
          "review"
        ],
        "title": "FixSafety",
        "type": "string"
      },
      "Format": {
        "description": "Formats of pasted `content`. Files (.docx, .tex, Overleaf .zip, …) go\nto /v1/analyze-file instead; `word_paragraphs` arrives with the hosted\nadd-in (S3).",
        "enum": [
          "plain",
          "markdown",
          "latex"
        ],
        "title": "Format",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "engine": {
            "$ref": "#/components/schemas/EngineInfo"
          },
          "status": {
            "description": "degraded when any tier the service is configured to run is not ok.",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "tiers": {
            "items": {
              "$ref": "#/components/schemas/TierHealth"
            },
            "title": "Tiers",
            "type": "array"
          }
        },
        "required": [
          "status",
          "tiers",
          "engine"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Metrics": {
        "additionalProperties": false,
        "description": "Read-outs, never a score (metrics.py).",
        "properties": {
          "boosters_per_100w": {
            "title": "Boosters Per 100W",
            "type": "number"
          },
          "hedge_booster_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hedge Booster Balance"
          },
          "hedges_per_100w": {
            "title": "Hedges Per 100W",
            "type": "number"
          },
          "long_sentences": {
            "title": "Long Sentences",
            "type": "integer"
          },
          "mean_sentence_len": {
            "title": "Mean Sentence Len",
            "type": "number"
          },
          "nominalizations_per_100w": {
            "title": "Nominalizations Per 100W",
            "type": "number"
          },
          "passive_share_by_section": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Share of clauses in the passive voice per section, as a fraction 0-1.",
            "title": "Passive Share By Section",
            "type": "object"
          },
          "self_mention_per_100w": {
            "title": "Self Mention Per 100W",
            "type": "number"
          },
          "sentences": {
            "title": "Sentences",
            "type": "integer"
          },
          "words": {
            "title": "Words",
            "type": "integer"
          }
        },
        "required": [
          "sentences",
          "words",
          "mean_sentence_len",
          "long_sentences",
          "nominalizations_per_100w",
          "hedges_per_100w",
          "boosters_per_100w",
          "self_mention_per_100w"
        ],
        "title": "Metrics",
        "type": "object"
      },
      "RuleInfo": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "fix_safety": {
            "$ref": "#/components/schemas/FixSafety"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sections_excluded": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sections Excluded"
          },
          "sections_only": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sections Only"
          },
          "short": {
            "title": "Short",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "why": {
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "short",
          "why",
          "source",
          "tier",
          "fix_safety"
        ],
        "title": "RuleInfo",
        "type": "object"
      },
      "RulesResponse": {
        "additionalProperties": false,
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleInfo"
            },
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "RulesResponse",
        "type": "object"
      },
      "Span": {
        "additionalProperties": false,
        "properties": {
          "col": {
            "description": "1-based column of `start`; 0 if unknown.",
            "minimum": 0.0,
            "title": "Col",
            "type": "integer"
          },
          "end": {
            "description": "Offset into `content` in Unicode code points, exclusive.",
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "line": {
            "description": "1-based line of `start`; 0 if unknown.",
            "minimum": 0.0,
            "title": "Line",
            "type": "integer"
          },
          "start": {
            "description": "Offset into `content` in Unicode code points (Python str indices, NOT UTF-16 units), inclusive.",
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end",
          "line",
          "col"
        ],
        "title": "Span",
        "type": "object"
      },
      "Suggestion": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "fix_safety": {
            "$ref": "#/components/schemas/FixSafety"
          },
          "id": {
            "description": "Stable fingerprint of (rule_id, start, end, text); used by /v1/feedback in S2.",
            "title": "Id",
            "type": "string"
          },
          "learn_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lesson id; Learn cards arrive in S4.",
            "title": "Learn Ref"
          },
          "message": {
            "description": "One-line rationale, always shown.",
            "title": "Message",
            "type": "string"
          },
          "replacement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A concrete fix, only from deterministic rules or a ≤40-char learned edit. Never generated prose.",
            "title": "Replacement"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "rule_name": {
            "title": "Rule Name",
            "type": "string"
          },
          "section": {
            "description": "Detected section, e.g. methods, discussion, unknown.",
            "title": "Section",
            "type": "string"
          },
          "source": {
            "description": "Named provenance of the advice (CLAUDE.md #6).",
            "title": "Source",
            "type": "string"
          },
          "span": {
            "$ref": "#/components/schemas/Span"
          },
          "text": {
            "description": "The flagged source text, content[start:end].",
            "title": "Text",
            "type": "string"
          },
          "tier": {
            "description": "spelling | grammar | gec | craft | lens — which engine produced it.",
            "title": "Tier",
            "type": "string"
          },
          "why": {
            "description": "The teachable explanation.",
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule_id",
          "rule_name",
          "category",
          "tier",
          "span",
          "text",
          "section",
          "message",
          "why",
          "source",
          "fix_safety",
          "confidence"
        ],
        "title": "Suggestion",
        "type": "object"
      },
      "TierHealth": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "ok": {
            "description": "Is this tier contributing suggestions right now?",
            "title": "Ok",
            "type": "boolean"
          },
          "remedy": {
            "default": "",
            "title": "Remedy",
            "type": "string"
          },
          "state": {
            "description": "ready | missing | disabled | error | unstarted",
            "title": "State",
            "type": "string"
          },
          "tier": {
            "description": "parser | spelling | grammar | gec | account (account: whether a signed-in caller's settings could be loaded)",
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "tier",
          "label",
          "ok",
          "state"
        ],
        "title": "TierHealth",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Document text is processed in memory for the duration of a request and is never stored, logged or used for training (ARCHITECTURE.md ADR-02).",
    "summary": "Explainable, section-aware feedback on research writing. Advises; never drafts.",
    "title": "Researchly Engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/analyze": {
      "post": {
        "description": "Check one document and return typed, explained suggestions.",
        "operationId": "analyze",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Document too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request failed validation"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Engine error (no document text in the body)"
          }
        },
        "summary": "Analyze",
        "tags": [
          "analysis"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Per-tier status. A degraded tier is reported, never hidden.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/rules": {
      "get": {
        "description": "The rule registry with why/source — powers Explain and settings UIs.",
        "operationId": "listRules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RulesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Rules",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
