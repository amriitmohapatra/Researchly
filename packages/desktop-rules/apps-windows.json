      "polling": { "needed": true, "interval_ms": 1000 }
    },
    {
      "label": "Microsoft Teams",
      "process": ["ms-teams.exe", "Teams.exe"],
      "enabled": true,
      "widget": { "corner": "top-right", "offset_x": 12, "offset_y": 6 },
      "forbidden_corners": ["bottom-right"],
